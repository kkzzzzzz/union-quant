# ==============================================================================
# 1. 关系型数据库连接配置 (已移除本地 SQLite，请配置外部数据库)
#    支持 PostgreSQL / MySQL / Supabase 直连等外部云端或自建数据库。
#
#    方式 A：直接填写完整连接串 (推荐)
#    - PostgreSQL / Supabase Postgres:
#      DATABASE_URL=postgresql://postgres.xxx:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#      DATABASE_URL=postgresql://user:password@127.0.0.1:5432/union_quant
#    - MySQL:
#      DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/union_quant
#
#    方式 B：独立参数配置 (未配置 DATABASE_URL 时自动拼装)
#    DB_TYPE=postgresql       # postgresql 或 mysql
#    DB_HOST=127.0.0.1
#    DB_PORT=5432
#    DB_USER=postgres
#    DB_PASSWORD=your_password
#    DB_NAME=union_quant
# ==============================================================================
DATABASE_URL=


# ==============================================================================
# 2. 统一 Supabase 数据库连接配置 (可选双写 & 一键迁移目标)
#    配置后可执行 `python cli.py migrate-supabase` 将本地数据一键全量推送至 Supabase
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-anon-key

# ==============================================================================
# 2. 统一消息推送通道配置 (可选，配置任意一个即可自动启用)
# ==============================================================================
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
FEISHU_WEBHOOK=
WECOM_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SERVERCHAN_KEY=
PUSHPLUS_TOKEN=
