# ==============================================================================
# 1. 本地/自建关系型数据库连接配置 (SQLAlchemy)
#    默认不填时自动使用本地关系库: sqlite:///data/union_quant.db
#    如需切换本地 MySQL: DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/union_quant
#    如需直连 Postgres : DATABASE_URL=postgresql+psycopg2://postgres:password@127.0.0.1:5432/postgres
# ==============================================================================
DATABASE_URL=

# ==============================================================================
# 2. 统一 Supabase 数据库连接配置 (可选双写 & 一键迁移目标)
#    配置后可执行 `python cli.py migrate-supabase` 将本地数据一键全量推送至 Supabase
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-anon-key

# ==============================================================================
# 2. 统一消息推送通道配置 (可选，配置任意一个即可自动启用)
# ==============================================================================
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
FEISHU_WEBHOOK=
WECOM_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SERVERCHAN_KEY=
PUSHPLUS_TOKEN=
